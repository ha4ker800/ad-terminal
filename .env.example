# ==========================================
# AD TERMINAL - Environment Variables
# Copy this to .env.local for local dev
# Set these in Vercel Dashboard > Settings > Environment Variables
# ==========================================

# ==========================================
# DATABASE - Neon PostgreSQL (REQUIRED)
# Get from: https://neon.tech → New Project → Connection String
# Make sure to copy the "Pooled connection" string (has ?pgbouncer=true)
# ==========================================
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# REDIS - Upstash (OPTIONAL but recommended for Vercel)
# Get from: https://upstash.com → Create Database → REST API
# Without this, command queue won't persist on Vercel
# ==========================================
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ==========================================
# AI API Keys (at least one required)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==========================================
# Telegram Bot (Optional)
# ==========================================
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ==========================================
# App URL (set after first Vercel deploy)
# ==========================================
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
